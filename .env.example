# 複製成 .env 後填入（.env 不會被 git 追蹤）。python orb.py init 會自動產生。
# 沒有在 config.toml 指定 notify.channels 時，必填欄位都填好的管道會自動啟用。

# ── ntfy（免費手機推播 App）
NTFY_TOPIC=
NTFY_TOKEN=                 # 有存取控制的 topic 才需要

# ── Telegram：@BotFather /newbot 取得 token；先傳訊息給 bot，再執行 python orb.py init 自動抓 chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Discord：頻道設定 → 整合 → Webhook
DISCORD_WEBHOOK_URL=

# ── Slack：Incoming Webhooks
SLACK_WEBHOOK_URL=

# ── LINE（Messaging API；LINE Notify 已於 2025-03-31 停止服務）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=                    # userId 或 groupId

# ── Email（SMTP；Gmail 請用「應用程式密碼」）
SMTP_HOST=
SMTP_PORT=587               # 587 = STARTTLS、465 = SSL
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=                   # 多個用逗號分隔
EMAIL_FROM=

# ── Pushover
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ── 自訂 Webhook（POST JSON：title、message、tags、priority、click、sent_at）
WEBHOOK_URL=

# ── 永豐 Shioaji（data.source = "shioaji" 才需要）
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
